  "keyFeatures": [
    "Solar-optimized EV charging with PV surplus mode",
    "Support for 200+ EV chargers (OCPP, EEBus, Modbus, HTTP)",
    "Vehicle integration for SoC tracking (30+ manufacturers)",
    "Smart home battery management with grid price optimization",
    "Scheduled charging plans with departure time and cost targets",
    "Dynamic tariff support (Tibber, Octopus, Awattar, Entsoe, etc.)",
    "REST and MQTT APIs for home automation integration",
    "Plugin system for custom device integrations (Modbus, HTTP, MQTT, JS, Go)",
    "Local-first — no cloud dependency",
    "InfluxDB and Grafana logging support"
  ],
  "publicApiSurface": [
    "GET /api/state — full site state snapshot",
    "POST /api/loadpoints/{id}/mode/{mode} — set charging mode (off/now/minpv/pv)",
    "POST /api/loadpoints/{id}/limitsoc/{soc} — set SoC limit",
    "POST /api/loadpoints/{id}/limitenergy/{energy} — set energy limit",
    "POST /api/loadpoints/{id}/plan/soc — set charging plan",
    "POST /api/batterydischargecontrol/{enable} — control battery discharge",
    "POST /api/batterymode/{batteryMode} — set external battery mode",
    "POST /api/buffersoc/{soc} — set buffer SoC",
    "GET /api/sessions — charging sessions history",
    "GET /api/tariff/{type} — get tariff rates",
    "POST /api/auth/login — admin authentication",
    "MQTT topic: evcc/# — real-time state updates",
    "MQTT topic: evcc/loadpoints/{id}/mode/set — set mode via MQTT"
  ]
}
